# Copy to .env for local overrides. Never commit a real .env.

# development | production | test
APP_ENV=development

# Required in production. Local default is the compose/dev database.
DATABASE_URL=postgres://openpos:openpos@localhost:5432/openpos?sslmode=disable

# Required in production: at least 32 characters, not a known development default.
JWT_SECRET=dev-secret-change-in-production

PORT=8080

# Browser origin allowed by CORS. Comma-separate extras via FRONTEND_ORIGINS.
FRONTEND_ORIGIN=http://localhost:5173

# Defaults to true in development and false in production.
ALLOW_PUBLIC_REGISTRATION=true

UPLOADS_DIR=uploads
STORE_NAME=OpenPOS

# Frontend build-time API base. Unset uses http://localhost:8080.
# VITE_API_URL=http://localhost:8080
